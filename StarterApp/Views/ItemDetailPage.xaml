<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="StarterApp.Views.ItemDetailPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             BackgroundColor="#F6F7FB"
             Title="{Binding Title}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="18">

            <Border BackgroundColor="White"
                    Stroke="#E5E7EB"
                    StrokeThickness="1"
                    Padding="18">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="18" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="12">

                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="{Binding Item.Title}"
                               FontSize="28"
                               FontAttributes="Bold"
                               TextColor="#111827" />

                        <Border Grid.Column="1"
                                BackgroundColor="#ECFEFF"
                                StrokeThickness="0"
                                Padding="10,4">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="20" />
                            </Border.StrokeShape>
                            <Label Text="{Binding Item.Category}"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   TextColor="#0E7490" />
                        </Border>
                    </Grid>

                    <Label Text="{Binding Item.Description}"
                           FontSize="15"
                           TextColor="#4B5563" />

                    <Label Text="{Binding Item.Location, StringFormat='Location: {0}'}"
                           FontSize="14"
                           TextColor="#6B7280" />

                    <Label Text="{Binding Item.DailyRate, StringFormat='£{0:F2} per day'}"
                           FontSize="22"
                           FontAttributes="Bold"
                           TextColor="#16A34A" />

                    <HorizontalStackLayout Spacing="10">
                        <Button Text="Request Rental"
                                BackgroundColor="#2563EB"
                                TextColor="White"
                                CornerRadius="12"
                                Command="{Binding RequestRentalCommand}" />

                        <Button Text="Edit Item"
                                BackgroundColor="#111827"
                                TextColor="White"
                                CornerRadius="12"
                                Command="{Binding EditItemCommand}"
                                IsVisible="{Binding CanEditItem}" />
                    </HorizontalStackLayout>

                </VerticalStackLayout>
            </Border>

            <Border BackgroundColor="White"
                    Stroke="#E5E7EB"
                    StrokeThickness="1"
                    Padding="16">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="18" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="12">

                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Reviews"
                               FontSize="22"
                               FontAttributes="Bold"
                               TextColor="#111827" />

                        <Label Grid.Column="1"
                               Text="{Binding AverageRating, StringFormat='★ {0:F1}/5'}"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="#F59E0B" />
                    </Grid>

                    <CollectionView ItemsSource="{Binding Reviews}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border BackgroundColor="#F9FAFB"
                                        Stroke="#E5E7EB"
                                        StrokeThickness="1"
                                        Padding="12"
                                        Margin="0,5">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="12" />
                                    </Border.StrokeShape>

                                    <VerticalStackLayout Spacing="4">
                                        <Label Text="{Binding Rating, StringFormat='★ {0}/5'}"
                                               FontAttributes="Bold"
                                               TextColor="#F59E0B" />
                                        <Label Text="{Binding Comment}"
                                               TextColor="#4B5563" />
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>