<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="StarterApp.Views.MainPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             BackgroundColor="#F6F7FB"
             Title="{Binding Title}">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Logout"
                     Command="{Binding LogoutCommand}" />
    </ContentPage.ToolbarItems>

    <RefreshView IsRefreshing="{Binding IsBusy}"
                 Command="{Binding RefreshDataCommand}">
        <ScrollView>
            <VerticalStackLayout Padding="20" Spacing="22">

                <Border BackgroundColor="#2563EB"
                        StrokeThickness="0"
                        Padding="22">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="22" />
                    </Border.StrokeShape>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="{Binding WelcomeMessage}"
                               FontSize="28"
                               FontAttributes="Bold"
                               TextColor="White" />

                        <Label Text="{Binding CurrentUser.Email}"
                               FontSize="14"
                               TextColor="#DBEAFE" />

                        <Label Text="Rent items, manage requests, and review completed rentals."
                               FontSize="14"
                               TextColor="#BFDBFE" />
                    </VerticalStackLayout>
                </Border>

                <Border BackgroundColor="#FEE2E2"
                        StrokeThickness="0"
                        Padding="12"
                        IsVisible="{Binding HasError}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14" />
                    </Border.StrokeShape>

                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="{Binding ErrorMessage}"
                               TextColor="#991B1B"
                               FontAttributes="Bold"
                               VerticalOptions="Center" />

                        <Button Grid.Column="1"
                                Text="×"
                                Command="{Binding ClearErrorCommand}"
                                BackgroundColor="Transparent"
                                TextColor="#991B1B"
                                FontSize="18"
                                Padding="0"
                                WidthRequest="32"
                                HeightRequest="32" />
                    </Grid>
                </Border>

                <Label Text="Quick Actions"
                       FontSize="22"
                       FontAttributes="Bold"
                       TextColor="#111827" />

                <Grid ColumnDefinitions="*,*"
                      RowDefinitions="Auto,Auto,Auto"
                      ColumnSpacing="14"
                      RowSpacing="14">

                    <Border Grid.Row="0"
                            Grid.Column="0"
                            BackgroundColor="White"
                            Stroke="#E5E7EB"
                            StrokeThickness="1"
                            Padding="16">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="18" />
                        </Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding NavigateToItemsCommand}" />
                        </Border.GestureRecognizers>

                        <VerticalStackLayout Spacing="8">
                            <Label Text="📦"
                                   FontSize="30" />
                            <Label Text="Browse Items"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   TextColor="#111827" />
                            <Label Text="Find items to rent"
                                   FontSize="12"
                                   TextColor="#6B7280" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Row="0"
                            Grid.Column="1"
                            BackgroundColor="White"
                            Stroke="#E5E7EB"
                            StrokeThickness="1"
                            Padding="16">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="18" />
                        </Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding NavigateToCreateItemCommand}" />
                        </Border.GestureRecognizers>

                        <VerticalStackLayout Spacing="8">
                            <Label Text="➕"
                                   FontSize="30" />
                            <Label Text="Create Item"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   TextColor="#111827" />
                            <Label Text="List something"
                                   FontSize="12"
                                   TextColor="#6B7280" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Row="1"
                            Grid.Column="0"
                            BackgroundColor="White"
                            Stroke="#E5E7EB"
                            StrokeThickness="1"
                            Padding="16">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="18" />
                        </Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding NavigateToRentalsCommand}" />
                        </Border.GestureRecognizers>

                        <VerticalStackLayout Spacing="8">
                            <Label Text="🧾"
                                   FontSize="30" />
                            <Label Text="Rentals"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   TextColor="#111827" />
                            <Label Text="Manage requests"
                                   FontSize="12"
                                   TextColor="#6B7280" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Row="1"
                            Grid.Column="1"
                            BackgroundColor="White"
                            Stroke="#E5E7EB"
                            StrokeThickness="1"
                            Padding="16">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="18" />
                        </Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding NavigateToProfileCommand}" />
                        </Border.GestureRecognizers>

                        <VerticalStackLayout Spacing="8">
                            <Label Text="👤"
                                   FontSize="30" />
                            <Label Text="Profile"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   TextColor="#111827" />
                            <Label Text="Your account"
                                   FontSize="12"
                                   TextColor="#6B7280" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Row="2"
                            Grid.ColumnSpan="2"
                            BackgroundColor="White"
                            Stroke="#E5E7EB"
                            StrokeThickness="1"
                            Padding="16"
                            IsVisible="{Binding IsAdmin}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="18" />
                        </Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding NavigateToUserListCommand}" />
                        </Border.GestureRecognizers>

                        <Grid ColumnDefinitions="Auto,*">
                            <Label Text="🔐"
                                   FontSize="30"
                                   VerticalOptions="Center" />

                            <VerticalStackLayout Grid.Column="1"
                                                 Margin="14,0,0,0"
                                                 Spacing="3">
                                <Label Text="User Management"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       TextColor="#111827" />
                                <Label Text="Manage users and roles"
                                       FontSize="12"
                                       TextColor="#6B7280" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                </Grid>

            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</ContentPage>